# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Optional. https://console.typesafe.ai — without it, Jev nodes run against a
# deterministic mock that picks answers by keyword overlap.
TYPESAFE_API_KEY=

# Optional. https://opencode.ai/zen — OpenCode Zen ("go" plan) API key. Without
# it, LLM nodes stream a canned mock reply.
OPENCODE_ZEN_API_KEY=

# Optional. Defaults to https://opencode.ai/zen/go/v1 (no /chat/completions
# suffix - the AI SDK appends it).
OPENCODE_ZEN_BASE_URL=

# Optional. https://tinyfish.ai — free Search and Fetch APIs for the Web search
# and Fetch nodes. Without it, both nodes return mock results.
TINYFISH_API_KEY=
